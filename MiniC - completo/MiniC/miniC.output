Gramática

    0 $accept: program $end

    1 $@1: ε

    2 program: $@1 functions

    3 functions: function
    4          | functions function

    5 $@2: ε

    6 $@3: ε

    7 function: tipo "id" "(" $@2 parametros_body ")" $@3 "{" body "}"

    8 parametros_decl: "int" "id"
    9                | "const" "int" "id"

   10 parametros_list: parametros_decl
   11                | parametros_list "," parametros_decl

   12 parametros_body: ε
   13                | parametros_list

   14 body: ε
   15     | body declaration
   16     | body statement

   17 $@4: ε

   18 declaration: "var" $@4 tipo id_list ";"

   19 $@5: ε

   20 declaration: "const" $@5 tipo id_list ";"

   21 tipo: "int"
   22     | "void"

   23 id_list: id_decl
   24        | id_list "," id_decl

   25 id_decl: "id"
   26        | "id" "=" expresion

   27 statement: "id" "=" expresion ";"
   28          | "{" statement_list "}"
   29          | "if" "(" expresion ")" statement
   30          | "if" "(" expresion ")" statement "else" statement
   31          | "while" "(" expresion ")" statement
   32          | "print" "(" print_list ")" ";"
   33          | "read" "(" read_list ")" ";"
   34          | "return" ";"
   35          | "return" expresion ";"

   36 statement_list: ε
   37               | statement_list statement

   38 print_list: print_item
   39           | print_list "," print_item

   40 print_item: expresion
   41           | "string"

   42 read_list: "id"
   43          | read_list "," "id"

   44 argumentos_body: ε
   45                | argumentos_list

   46 argumentos_list: expresion
   47                | argumentos_list "," expresion

   48 expresion: expresion "+" expresion
   49          | expresion "-" expresion
   50          | expresion "*" expresion
   51          | expresion "/" expresion
   52          | "-" expresion
   53          | "(" expresion ")"
   54          | "id"

   55 $@6: ε

   56 expresion: "id" "(" $@6 argumentos_body ")"
   57          | "num"


