Gramática

    0 $accept: program $end

    1 $@1: ε

    2 program: $@1 "void" "id" "(" ")" "{" body "}"

    3 body: ε
    4     | body declaration
    5     | body statement

    6 $@2: ε

    7 declaration: "var" $@2 tipo id_list ";"

    8 $@3: ε

    9 declaration: "const" $@3 tipo id_list ";"

   10 tipo: "int"

   11 id_list: id_decl
   12        | id_list "," id_decl

   13 id_decl: "id"
   14        | "id" "=" expresion

   15 statement: "id" "=" expresion ";"
   16          | "{" statement_list "}"
   17          | "if" "(" expresion ")" statement
   18          | "if" "(" expresion ")" statement "else" statement
   19          | "while" "(" expresion ")" statement
   20          | "print" "(" print_list ")" ";"
   21          | "read" "(" read_list ")" ";"
   22          | "return" ";"

   23 statement_list: ε
   24               | statement_list statement

   25 print_list: print_item
   26           | print_list "," print_item

   27 print_item: expresion
   28           | "string"

   29 read_list: "id"
   30          | read_list "," "id"

   31 expresion: expresion "+" expresion
   32          | expresion "-" expresion
   33          | expresion "*" expresion
   34          | expresion "/" expresion
   35          | "-" expresion
   36          | "(" expresion ")"
   37          | "id"
   38          | "num"


