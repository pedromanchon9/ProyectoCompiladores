Gramática

    0 $accept: program $end

    1 $@1: ε

    2 program: $@1 "void" "id" "(" ")" "{" body "}"

    3 body: ε
    4     | body declaration
    5     | body statement

    6 $@2: ε

    7 declaration: "var" $@2 tipo id_list ";"

    8 $@3: ε

    9 declaration: "const" $@3 tipo id_list ";"

   10 tipo: "int"

   11 id_list: id_decl
   12        | id_list "," id_decl

   13 id_decl: "id"
   14        | "id" "=" expresion

   15 statement: "id" "=" expresion ";"
   16          | "{" statement_list "}"
   17          | "if" "(" expresion ")" "else" statement
   18          | "if" "(" expresion ")" statement
   19          | "while" "(" expresion ")" statement
   20          | "print" "(" print_list ")" ";"
   21          | "read" "(" read_list ")" ";"

   22 statement_list: statement_list statement
   23               | ε

   24 print_list: print_item
   25           | print_list "," print_item

   26 print_item: expresion

   27 read_list: "id"
   28          | read_list "," "id"

   29 expresion: expresion "+" expresion
   30          | expresion "-" expresion
   31          | expresion "*" expresion
   32          | expresion "/" expresion
   33          | "-" expresion
   34          | "(" expresion ")"
   35          | "id"
   36          | "num"


