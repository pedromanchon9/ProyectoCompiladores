Gramática

    0 $accept: program $end

    1 $@1: ε

    2 program: $@1 "void" "id" "(" ")" "{" body "}"

    3 body: ε
    4     | body declaration
    5     | body statement
    6     | ε

    7 declaration: ε

    8 $@2: ε

    9 declaration: "var" $@2 tipo id_list ";"

   10 $@3: ε

   11 declaration: "const" $@3 tipo id_list ";"

   12 tipo: "int"

   13 id_list: id_decl
   14        | id_list "," id_decl

   15 id_decl: "id"
   16        | "id" "=" expresion

   17 statement: "id" "=" expresion ";"
   18          | "{" statement_list "}"
   19          | "if" "(" expresion ")" "else" statement
   20          | "if" "(" expresion ")"
   21          | "while" "(" expresion ")" statement
   22          | "print" "(" print_list ")" ";"
   23          | "read" "(" read_list ")" ";"

   24 statement_list: statement_list statement
   25               | ε

   26 print_list: print_item
   27           | print_list "," print_item

   28 print_item: expresion

   29 read_list: "id"
   30          | read_list "," "id"

   31 expresion: expresion "+" expresion
   32          | expresion "-" expresion
   33          | expresion "*" expresion
   34          | expresion "/" expresion
   35          | "-" expresion
   36          | "(" expresion ")"
   37          | "id"
   38          | "num"


